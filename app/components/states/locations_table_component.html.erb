<div class="locations-table">
  <div class="scroll">
    <table>
      <colgroup>
        <col class="name" />
        <col class="measures" />
      </colgroup>
      <thead>
        <tr>
          <th>Location</th>
          <th>Measurements</th>
        </tr>
      </thead>
      <tbody>
        <% counties.each do |county_name, locations| %>
          <tr>
            <th
              id="<%= county_dom_id(county_name) %>"
              colspan="2"
              scope="colgroup"
              class="county"
            >
              <%= county_name %>
            </th>
          </tr>
          <% locations.each do |loc| %>
            <%
              name = loc[:name] || loc["name"]
              path = loc[:path] || loc["path"]
            %>
            <tr class="row">
              <td>
                <%= link_to helpers.display_location_name(name), path %>
              </td>
              <td>
                <div class="chips">
                  <% if loc[:has_water_level] || loc["has_water_level"] %>
                    <div class="chip">Water level</div>
                  <% end %>
                  <% if loc[:has_discharge] || loc["has_discharge"] %>
                    <div class="chip">Flow</div>
                  <% end %>
                  <% if loc[:has_temperature] || loc["has_temperature"] %>
                    <div class="chip">Temperature</div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
