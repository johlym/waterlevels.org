<div
  id="<%= @id %>"
  class="app-dialog"
  data-controller="dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="<%= @id %>-title"
  aria-describedby="<%= @id %>-body"
  hidden
>
  <div class="app-dialog-backdrop" data-action="click->dialog#close" aria-hidden="true"></div>
  <div class="app-dialog-panel">
    <div class="app-dialog-header">
      <h2 id="<%= @id %>-title" data-dialog-target="title">Couldn’t get your location</h2>
      <button
        type="button"
        class="app-dialog-dismiss"
        data-action="dialog#close"
        aria-label="Close"
      >
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <p id="<%= @id %>-body" data-dialog-target="body">
      Your device couldn’t determine your position. Try again, or search for a station by name.
    </p>
    <div class="app-dialog-actions">
      <button
        type="button"
        class="app-dialog-confirm"
        data-dialog-target="closeButton"
        data-action="dialog#close"
      >
        OK
      </button>
    </div>
  </div>
</div>
