<section class="mt-10" aria-labelledby="current-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="current-heading" class="text-base font-semibold text-rolling-stone-950 dark:text-white">Current conditions</h2>
    <% if has_temperature? %>
      <div class="inline-flex rounded-lg bg-rolling-stone-950/5 p-1 dark:bg-white/5" role="group" aria-label="Temperature units">
        <button type="button" data-action="temperature-unit#setF" class="rounded-md px-3 py-1.5 text-base font-medium text-rolling-stone-700 hover:text-rolling-stone-950 dark:text-rolling-stone-300 dark:hover:text-white sm:text-sm">°F</button>
        <button type="button" data-action="temperature-unit#setC" class="rounded-md px-3 py-1.5 text-base font-medium text-rolling-stone-700 hover:text-rolling-stone-950 dark:text-rolling-stone-300 dark:hover:text-white sm:text-sm">°C</button>
      </div>
    <% end %>
  </div>

  <div class="@container mt-4">
    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-xl bg-rolling-stone-950/5 outline outline-rolling-stone-950/10 dark:bg-white/5 dark:outline-white/10 sm:grid-cols-2 lg:grid-cols-3"
      role="tablist"
      aria-label="Measurements"
      data-parameter-toggle-target="tabs"
    >
      <% @measurements.each_with_index do |m, index| %>
        <%
          kind = m[:kind] || m["kind"]
          label = m[:label] || m["label"]
          value = m[:value] || m["value"]
          unit = m[:unit] || m["unit"]
          code = m[:parameter_code] || m["parameter_code"]
          precision = m[:precision] || m["precision"] || 2
          trends = m[:trends] || m["trends"] || {}
          extremes = m[:extremes] || m["extremes"] || {}
          change_24h = trends[:change_24h] || trends["change_24h"]
          yoy = trends[:yoy] || trends["yoy"]
          high = extremes.dig(:high, :value) || extremes.dig("high", "value")
          low = extremes.dig(:low, :value) || extremes.dig("low", "value")
          selected = index.zero?
        %>
        <button
          type="button"
          role="tab"
          id="measurement-tab-<%= code %>"
          aria-selected="<%= selected %>"
          aria-controls="graph-panel"
          tabindex="<%= selected ? 0 : -1 %>"
          class="group flex flex-col gap-3 bg-white p-6 text-left hover:bg-rolling-stone-50 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-smalt-600 aria-selected:bg-smalt-50 dark:bg-rolling-stone-950 dark:hover:bg-rolling-stone-900 dark:aria-selected:bg-smalt-950/50"
          data-action="parameter-toggle#select"
          data-parameter-toggle-kind-param="<%= kind %>"
          data-parameter-toggle-parameter-code-param="<%= code %>"
          data-parameter-toggle-target="tab"
        >
          <div class="truncate text-base font-medium text-rolling-stone-500 group-aria-selected:text-smalt-700 dark:text-rolling-stone-400 dark:group-aria-selected:text-smalt-300 sm:text-sm"><%= label %></div>
          <% if kind == "temperature" %>
            <div
              class="text-3xl font-semibold tracking-tight text-rolling-stone-950 tabular-nums group-aria-selected:text-smalt-900 dark:text-white dark:group-aria-selected:text-smalt-100 sm:text-2xl"
              data-temperature-unit-target="display"
              data-temp-c="<%= value %>"
            ></div>
          <% else %>
            <div class="flex items-baseline gap-2">
              <div class="text-3xl font-semibold tracking-tight text-rolling-stone-950 tabular-nums group-aria-selected:text-smalt-900 dark:text-white dark:group-aria-selected:text-smalt-100 sm:text-2xl">
                <%= number_with_precision(value, precision: precision) %>
              </div>
              <div class="text-base text-rolling-stone-500 dark:text-rolling-stone-400"><%= unit %></div>
            </div>
          <% end %>
          <div class="flex flex-col gap-1 text-base text-rolling-stone-600 dark:text-rolling-stone-400 sm:text-sm">
            <% if change_24h %>
              <p>24h <%= format(precision.zero? ? "%+.0f" : "%+.2f", change_24h) %> <%= unit %></p>
            <% end %>
            <% if yoy %>
              <p>YoY <%= format(precision.zero? ? "%+.0f" : "%+.2f", yoy) %> <%= unit %></p>
            <% end %>
            <% if high || low %>
              <p>
                High <%= high ? number_with_precision(high, precision: precision) : "—" %>
                · Low <%= low ? number_with_precision(low, precision: precision) : "—" %>
              </p>
            <% end %>
          </div>
        </button>
      <% end %>
    </div>
  </div>
</section>
