<section class="mt-10" aria-labelledby="current-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="current-heading" class="text-base font-semibold text-rolling-stone-950 dark:text-white">Current conditions</h2>
    <% if has_temperature? %>
      <div class="inline-flex rounded-lg bg-rolling-stone-950/5 p-1 dark:bg-white/5" role="group" aria-label="Temperature units">
        <button
          type="button"
          data-action="temperature-unit#setF"
          data-temperature-unit-target="button"
          data-temperature-unit-unit-param="f"
          aria-pressed="true"
          class="rounded-md px-3 py-1.5 text-base font-medium text-rolling-stone-600 hover:text-rolling-stone-950 aria-pressed:bg-white aria-pressed:text-rolling-stone-950 aria-pressed:shadow-sm dark:text-rolling-stone-300 dark:hover:text-white dark:aria-pressed:bg-rolling-stone-800 dark:aria-pressed:text-white sm:text-sm"
        >°F</button>
        <button
          type="button"
          data-action="temperature-unit#setC"
          data-temperature-unit-target="button"
          data-temperature-unit-unit-param="c"
          aria-pressed="false"
          class="rounded-md px-3 py-1.5 text-base font-medium text-rolling-stone-600 hover:text-rolling-stone-950 aria-pressed:bg-white aria-pressed:text-rolling-stone-950 aria-pressed:shadow-sm dark:text-rolling-stone-300 dark:hover:text-white dark:aria-pressed:bg-rolling-stone-800 dark:aria-pressed:text-white sm:text-sm"
        >°C</button>
      </div>
    <% end %>
  </div>

  <div
    class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
    role="tablist"
    aria-label="Measurements"
    data-parameter-toggle-target="tabs"
  >
    <% @measurements.each_with_index do |m, index| %>
      <%
        kind = m[:kind] || m["kind"]
        label = m[:label] || m["label"]
        value = m[:value] || m["value"]
        unit = m[:unit] || m["unit"]
        code = m[:parameter_code] || m["parameter_code"]
        precision = m[:precision] || m["precision"] || 2
        trends = m[:trends] || m["trends"] || {}
        extremes = m[:extremes] || m["extremes"] || {}
        change_24h = trends[:change_24h] || trends["change_24h"]
        yoy = trends[:yoy] || trends["yoy"]
        high = extremes.dig(:high, :value) || extremes.dig("high", "value")
        low = extremes.dig(:low, :value) || extremes.dig("low", "value")
        selected = index.zero?
      %>
      <button
        type="button"
        role="tab"
        id="measurement-tab-<%= code %>"
        aria-selected="<%= selected %>"
        aria-controls="graph-panel"
        tabindex="<%= selected ? 0 : -1 %>"
        class="flex flex-col gap-3 rounded-xl border border-rolling-stone-300 bg-white p-5 text-left shadow-sm hover:border-rolling-stone-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-smalt-600 aria-selected:border-smalt-600 aria-selected:bg-white aria-selected:ring-2 aria-selected:ring-smalt-600/30 dark:border-transparent dark:bg-rolling-stone-900 dark:shadow-none dark:inset-ring dark:inset-ring-white/10 dark:hover:inset-ring-white/20 dark:aria-selected:bg-rolling-stone-900 dark:aria-selected:inset-ring-2 dark:aria-selected:inset-ring-smalt-400/50 dark:aria-selected:ring-0"
        data-action="parameter-toggle#select"
        data-parameter-toggle-kind-param="<%= kind %>"
        data-parameter-toggle-parameter-code-param="<%= code %>"
        data-parameter-toggle-target="tab"
      >
        <div class="truncate text-base font-medium text-rolling-stone-800 dark:text-rolling-stone-200 sm:text-sm"><%= label %></div>
        <% if kind == "temperature" %>
          <div
            class="text-3xl font-semibold tracking-tight text-rolling-stone-950 tabular-nums dark:text-white sm:text-2xl"
            data-temperature-unit-target="display"
            data-temp-c="<%= value %>"
          ></div>
        <% else %>
          <div class="flex items-baseline gap-2">
            <div class="text-3xl font-semibold tracking-tight text-rolling-stone-950 tabular-nums dark:text-white sm:text-2xl">
              <%= number_with_precision(value, precision: precision) %>
            </div>
            <div class="text-base font-medium text-rolling-stone-700 dark:text-rolling-stone-300"><%= unit %></div>
          </div>
        <% end %>
        <div class="flex flex-col gap-1 text-base text-rolling-stone-700 dark:text-rolling-stone-300 sm:text-sm">
          <% if change_24h %>
            <p>24h <%= format(precision.zero? ? "%+.0f" : "%+.2f", change_24h) %> <%= unit %></p>
          <% end %>
          <% if yoy %>
            <p>YoY <%= format(precision.zero? ? "%+.0f" : "%+.2f", yoy) %> <%= unit %></p>
          <% end %>
          <% if high || low %>
            <p>
              High <%= high ? number_with_precision(high, precision: precision) : "—" %>
              · Low <%= low ? number_with_precision(low, precision: precision) : "—" %>
            </p>
          <% end %>
        </div>
      </button>
    <% end %>
  </div>
</section>
