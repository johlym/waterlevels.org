<section class="measurements" aria-labelledby="current-heading">
  <div class="section-head">
    <h2 id="current-heading">Current conditions</h2>
    <% if has_temperature? %>
      <div class="segmented" role="group" aria-label="Temperature units">
        <button
          type="button"
          data-action="temperature-unit#setF"
          data-temperature-unit-target="button"
          data-temperature-unit-unit-param="f"
          aria-pressed="true"
        >°F</button>
        <button
          type="button"
          data-action="temperature-unit#setC"
          data-temperature-unit-target="button"
          data-temperature-unit-unit-param="c"
          aria-pressed="false"
        >°C</button>
      </div>
    <% end %>
  </div>

  <div
    class="cards"
    role="tablist"
    aria-label="Measurements"
    data-parameter-toggle-target="tabs"
  >
    <% @measurements.each_with_index do |m, index| %>
      <%
        kind = m[:kind] || m["kind"]
        label = m[:label] || m["label"]
        value = m[:value] || m["value"]
        unit = helpers.display_unit(m[:unit] || m["unit"])
        code = m[:parameter_code] || m["parameter_code"]
        precision = m[:precision] || m["precision"] || 2
        trends = m[:trends] || m["trends"] || {}
        extremes = m[:extremes] || m["extremes"] || {}
        change_24h = trends[:change_24h] || trends["change_24h"]
        change_24h_percent = trends[:change_24h_percent] || trends["change_24h_percent"]
        yoy = trends[:yoy] || trends["yoy"]
        high = extremes.dig(:high, :value) || extremes.dig("high", "value")
        low = extremes.dig(:low, :value) || extremes.dig("low", "value")
        high_year = extremes.dig(:high, :water_year) || extremes.dig("high", "water_year")
        peak = m[:peak] || m["peak"] || {}
        margin = peak[:margin] || peak["margin"]
        peak_year = peak[:water_year] || peak["water_year"]
        year_min = peak[:year_min] || peak["year_min"]
        year_max = peak[:year_max] || peak["year_max"]
        record = peak[:record] || peak["record"]
        year_span = year_min == year_max ? year_min : "#{year_min}–#{year_max}"
        selected = index.zero?
      %>
      <button
        type="button"
        role="tab"
        id="measurement-tab-<%= code %>"
        aria-selected="<%= selected %>"
        aria-controls="graph-panel"
        tabindex="<%= selected ? 0 : -1 %>"
        class="measurement-card"
        data-action="parameter-toggle#select"
        data-parameter-toggle-kind-param="<%= kind %>"
        data-parameter-toggle-parameter-code-param="<%= code %>"
        data-parameter-toggle-target="tab"
      >
        <div class="label"><%= helpers.annotate_glossary_terms(label, focusable: false) %></div>
        <% if kind == "temperature" %>
          <div
            class="value"
            data-temperature-unit-target="display"
            data-temp-c="<%= value %>"
          ><%= helpers.display_temperature_c(value) %></div>
        <% else %>
          <div class="value-row">
            <div class="value">
              <%= helpers.display_gauge_value(value, precision: precision) %>
            </div>
            <div class="unit"><%= unit %></div>
          </div>
        <% end %>
        <div class="trends">
          <% if change_24h || yoy %>
            <div class="stat-grid">
              <% if change_24h %>
                <div class="stat-cell">
                  <div class="stat-label">24h</div>
                  <div class="stat-value">
                    <% if kind == "temperature" %>
                      <span class="stat-figure" data-temperature-unit-target="display" data-temp-delta-c="<%= change_24h %>"><%= helpers.display_temperature_delta_c(change_24h) %></span>
                    <% else %>
                      <span class="stat-figure"><%= helpers.signed_number(change_24h, precision: precision) %></span>
                      <span class="stat-unit"><%= unit %></span>
                    <% end %>
                    <% if kind == "discharge" && change_24h_percent %>
                      <span class="stat-percent">(<%= format("%+.1f", change_24h_percent.to_f) %>%)</span>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <% if yoy %>
                <div class="stat-cell">
                  <div class="stat-label">YoY</div>
                  <div class="stat-value">
                    <% if kind == "temperature" %>
                      <span class="stat-figure" data-temperature-unit-target="display" data-temp-delta-c="<%= yoy %>"><%= helpers.display_temperature_delta_c(yoy) %></span>
                    <% else %>
                      <span class="stat-figure"><%= helpers.signed_number(yoy, precision: precision) %></span>
                      <span class="stat-unit"><%= unit %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if high || low %>
            <div class="stat-grid">
              <div class="stat-cell">
                <div class="stat-label">
                  <span>High</span>
                  <% if kind != "temperature" && high_year %>
                    <span class="stat-year"><span class="sr-only">water year </span>(<%= high_year %>)</span>
                  <% end %>
                </div>
                <div class="stat-value">
                  <% if kind == "temperature" %>
                    <% if high %>
                      <span class="stat-figure" data-temperature-unit-target="display" data-temp-c="<%= high %>" data-temp-hide-unit="true"><%= helpers.display_temperature_c(high, hide_unit: true) %></span>
                    <% else %>
                      <span class="stat-figure">—</span>
                    <% end %>
                  <% else %>
                    <span class="stat-figure"><%= high ? helpers.display_gauge_value(high, precision: precision) : "—" %></span>
                  <% end %>
                </div>
              </div>
              <div class="stat-cell">
                <div class="stat-label">Low</div>
                <div class="stat-value">
                  <% if kind == "temperature" %>
                    <% if low %>
                      <span class="stat-figure" data-temperature-unit-target="display" data-temp-c="<%= low %>" data-temp-hide-unit="true"><%= helpers.display_temperature_c(low, hide_unit: true) %></span>
                    <% else %>
                      <span class="stat-figure">—</span>
                    <% end %>
                  <% else %>
                    <span class="stat-figure"><%= low ? helpers.display_gauge_value(low, precision: precision) : "—" %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <% if kind != "temperature" && record %>
            <div class="peak-note peak-note--record">
              <div class="stat-label">New high</div>
              <div class="stat-value">
                <span class="stat-figure"><%= helpers.display_gauge_value(margin, precision: precision) %></span>
                <span class="stat-unit"><%= unit %></span>
              </div>
              <p class="peak-caption">above every annual peak on file (<%= year_span %>)</p>
            </div>
          <% elsif kind != "temperature" && margin && margin.to_f.negative? && peak_year %>
            <div class="peak-note">
              <div class="stat-value">
                <span class="stat-figure"><%= helpers.display_gauge_value(margin.to_f.abs, precision: precision) %></span>
                <span class="stat-unit"><%= unit %></span>
              </div>
              <p class="peak-caption">below the water year <%= peak_year %> peak</p>
            </div>
          <% elsif kind != "temperature" && margin && margin.to_f.positive? && peak_year %>
            <div class="peak-note">
              <div class="stat-value">
                <span class="stat-figure"><%= helpers.display_gauge_value(margin, precision: precision) %></span>
                <span class="stat-unit"><%= unit %></span>
              </div>
              <p class="peak-caption">above the water year <%= peak_year %> peak</p>
            </div>
          <% end %>
        </div>
      </button>
    <% end %>
  </div>
  <% mention = featured_mention %>
  <% if mention %>
    <p class="featured-trend">
      <%= helpers.link_to mention[:text], helpers.root_path(anchor: mention[:anchor]) %>
    </p>
  <% end %>
</section>
