<%
  errors = @contact_message.errors
  field_error = ->(attr) { errors[attr].to_a.first }
  field_aria = ->(attr, error_id) {
    return {} unless errors[attr].any?

    { invalid: true, describedby: error_id }
  }
%>
<%= form_with model: @contact_message, url: contact_path, method: :post, id: "contact-form", class: "contact-form", data: { turbo: false } do |f| %>
  <%= helpers.invisible_captcha :subtitle %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name,
          required: true,
          autocomplete: "name",
          placeholder: "Your name",
          aria: field_aria.call(:name, "contact-name-error") %>
    <% if (message = field_error.call(:name)) %>
      <p id="contact-name-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :email, "Email address" %>
    <%= f.email_field :email,
          required: true,
          autocomplete: "email",
          placeholder: "you@example.com",
          aria: field_aria.call(:email, "contact-email-error") %>
    <% if (message = field_error.call(:email)) %>
      <p id="contact-email-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :subject %>
    <%= f.text_field :subject,
          required: true,
          placeholder: "Gauge question, feedback, partnership…",
          aria: field_aria.call(:subject, "contact-subject-error") %>
    <% if (message = field_error.call(:subject)) %>
      <p id="contact-subject-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :message, "Your message" %>
    <%= f.text_area :message,
          required: true,
          rows: 5,
          placeholder: "Share details so we can help…",
          aria: field_aria.call(:message, "contact-message-error") %>
    <% if (message = field_error.call(:message)) %>
      <p id="contact-message-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div
    class="cf-turnstile turnstile"
    data-sitekey="<%= site_key %>"
    data-theme="dark"
    data-action="turnstile-spin-v2"
    aria-label="Bot check"
  ></div>
  <% if errors[:base].any? %>
    <p id="contact-turnstile-error" class="field-error" role="alert"><%= errors[:base].to_sentence %></p>
  <% end %>
  <p class="aside turnstile-fallback">
    Having trouble with the bot check?
    <%= mail_to "hello@waterlevels.org", "Email hello@waterlevels.org" %> instead.
  </p>

  <%= f.submit "Send message", class: "submit" %>
<% end %>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  document.getElementById("contact-form")?.addEventListener("submit", () => {
    setTimeout(() => window.turnstile?.reset(), 0)
  })
</script>
