<%= form_with model: @contact_message, url: contact_path, method: :post, id: "contact-form", class: "contact-form", data: { turbo: false } do |f| %>
  <%= helpers.invisible_captcha :subtitle %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true, autocomplete: "name", placeholder: "Your name" %>
  </div>

  <div class="field">
    <%= f.label :email, "Email address" %>
    <%= f.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com" %>
  </div>

  <div class="field">
    <%= f.label :subject %>
    <%= f.text_field :subject, required: true, placeholder: "Gauge question, feedback, partnership…" %>
  </div>

  <div class="field">
    <%= f.label :message, "Your message" %>
    <%= f.text_area :message, required: true, rows: 5, placeholder: "Share details so we can help…" %>
  </div>

  <div class="cf-turnstile turnstile" data-sitekey="<%= site_key %>" data-theme="dark" data-action="turnstile-spin-v2"></div>

  <%= f.submit "Send message", class: "submit" %>
<% end %>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  document.getElementById("contact-form")?.addEventListener("submit", () => {
    setTimeout(() => window.turnstile?.reset(), 0)
  })
</script>
