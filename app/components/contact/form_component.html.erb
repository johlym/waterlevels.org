<%
  errors = @contact_message.errors
  field_error = ->(attr) { errors[attr].to_a.first }
  first_invalid = %i[name email subject message].find { |attr| errors[attr].any? }
  field_aria = ->(attr, error_id) {
    return {} unless errors[attr].any?

    { invalid: true, describedby: error_id }
  }
%>
<%= form_with model: @contact_message, url: contact_path, method: :post, id: "contact-form", class: "contact-form", data: { turbo: false } do |f| %>
  <div hidden><%= helpers.invisible_captcha :subtitle %></div>

  <div class="field">
    <%= f.label :name do %>
      Name <span class="required-note">(required)</span>
    <% end %>
    <%= f.text_field :name,
          required: true,
          autocomplete: "name",
          placeholder: "Your name",
          autofocus: first_invalid == :name,
          aria: field_aria.call(:name, "contact-name-error") %>
    <% if (message = field_error.call(:name)) %>
      <p id="contact-name-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :email do %>
      Email address <span class="required-note">(required)</span>
    <% end %>
    <%= f.email_field :email,
          required: true,
          autocomplete: "email",
          placeholder: "you@example.com",
          autofocus: first_invalid == :email,
          aria: field_aria.call(:email, "contact-email-error") %>
    <% if (message = field_error.call(:email)) %>
      <p id="contact-email-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :subject do %>
      Subject <span class="required-note">(required)</span>
    <% end %>
    <%= f.text_field :subject,
          required: true,
          placeholder: "Gauge question, feedback, partnership…",
          autofocus: first_invalid == :subject,
          aria: field_aria.call(:subject, "contact-subject-error") %>
    <% if (message = field_error.call(:subject)) %>
      <p id="contact-subject-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :message do %>
      Your message <span class="required-note">(required)</span>
    <% end %>
    <%= f.text_area :message,
          required: true,
          rows: 5,
          placeholder: "Share details so we can help…",
          autofocus: first_invalid == :message,
          aria: field_aria.call(:message, "contact-message-error") %>
    <% if (message = field_error.call(:message)) %>
      <p id="contact-message-error" class="field-error"><%= message %></p>
    <% end %>
  </div>

  <fieldset class="turnstile-field" <% if errors[:base].any? %>aria-describedby="contact-turnstile-error"<% end %>>
    <legend>Bot check</legend>
    <div
      class="cf-turnstile turnstile"
      data-sitekey="<%= site_key %>"
      data-theme="dark"
      data-action="<%= TurnstileVerification::CONTACT %>"
    ></div>
    <% if errors[:base].any? %>
      <p id="contact-turnstile-error" class="field-error" role="alert"><%= errors[:base].to_sentence %></p>
    <% end %>
    <p class="aside turnstile-fallback">
      Having trouble with the bot check?
      <%= mail_to "contact@waterlevels.org", "Email contact@waterlevels.org" %> instead.
    </p>
  </fieldset>

  <%= f.submit "Send message", class: "submit" %>
<% end %>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
