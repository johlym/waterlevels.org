<%= form_with model: @contact_message, url: contact_path, method: :post, id: "contact-form", class: "mt-10 space-y-6", data: { turbo: false } do |f| %>
  <%= helpers.invisible_captcha :subtitle %>

  <div class="flex flex-col gap-2">
    <%= f.label :name, class: "text-base font-medium text-rolling-stone-950 dark:text-white sm:text-sm" %>
    <%= f.text_field :name, required: true, autocomplete: "name", class: "block w-full rounded-lg bg-white px-3.5 py-2.5 text-base text-rolling-stone-950 outline outline-rolling-stone-950/15 placeholder:text-rolling-stone-400 focus:outline-2 focus:outline-smalt-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-rolling-stone-500 sm:text-sm" %>
  </div>

  <div class="flex flex-col gap-2">
    <%= f.label :email, class: "text-base font-medium text-rolling-stone-950 dark:text-white sm:text-sm" %>
    <%= f.email_field :email, required: true, autocomplete: "email", class: "block w-full rounded-lg bg-white px-3.5 py-2.5 text-base text-rolling-stone-950 outline outline-rolling-stone-950/15 placeholder:text-rolling-stone-400 focus:outline-2 focus:outline-smalt-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-rolling-stone-500 sm:text-sm" %>
  </div>

  <div class="flex flex-col gap-2">
    <%= f.label :subject, class: "text-base font-medium text-rolling-stone-950 dark:text-white sm:text-sm" %>
    <%= f.text_field :subject, required: true, class: "block w-full rounded-lg bg-white px-3.5 py-2.5 text-base text-rolling-stone-950 outline outline-rolling-stone-950/15 placeholder:text-rolling-stone-400 focus:outline-2 focus:outline-smalt-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-rolling-stone-500 sm:text-sm" %>
  </div>

  <div class="flex flex-col gap-2">
    <%= f.label :message, class: "text-base font-medium text-rolling-stone-950 dark:text-white sm:text-sm" %>
    <%= f.text_area :message, required: true, rows: 6, class: "block w-full rounded-lg bg-white px-3.5 py-2.5 text-base text-rolling-stone-950 outline outline-rolling-stone-950/15 placeholder:text-rolling-stone-400 focus:outline-2 focus:outline-smalt-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-rolling-stone-500 sm:text-sm" %>
  </div>

  <div class="cf-turnstile" data-sitekey="<%= site_key %>" data-theme="auto" data-action="turnstile-spin-v2"></div>

  <%= f.submit "Send message", class: "inline-flex w-full cursor-pointer items-center justify-center rounded-lg bg-smalt-700 px-4 py-2.5 text-base font-medium text-white hover:bg-smalt-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-smalt-600 dark:bg-smalt-400 dark:text-rolling-stone-950 dark:hover:bg-smalt-300 sm:w-auto sm:text-sm" %>
<% end %>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  document.getElementById("contact-form")?.addEventListener("submit", () => {
    setTimeout(() => window.turnstile?.reset(), 0)
  })
</script>
