<%= form_with model: @contact_message, url: contact_path, method: :post, class: "mt-8 space-y-5", data: { turbo: false } do |f| %>
  <%= helpers.invisible_captcha :subtitle %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-rolling-stone-800 dark:text-rolling-stone-100" %>
    <%= f.text_field :name, required: true, autocomplete: "name", class: "mt-1 w-full rounded-md border border-rolling-stone-300 bg-white px-3 py-2 text-rolling-stone-900 dark:border-rolling-stone-700 dark:bg-rolling-stone-900 dark:text-rolling-stone-50" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-rolling-stone-800 dark:text-rolling-stone-100" %>
    <%= f.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded-md border border-rolling-stone-300 bg-white px-3 py-2 text-rolling-stone-900 dark:border-rolling-stone-700 dark:bg-rolling-stone-900 dark:text-rolling-stone-50" %>
  </div>

  <div>
    <%= f.label :subject, class: "block text-sm font-medium text-rolling-stone-800 dark:text-rolling-stone-100" %>
    <%= f.text_field :subject, required: true, class: "mt-1 w-full rounded-md border border-rolling-stone-300 bg-white px-3 py-2 text-rolling-stone-900 dark:border-rolling-stone-700 dark:bg-rolling-stone-900 dark:text-rolling-stone-50" %>
  </div>

  <div>
    <%= f.label :message, class: "block text-sm font-medium text-rolling-stone-800 dark:text-rolling-stone-100" %>
    <%= f.text_area :message, required: true, rows: 6, class: "mt-1 w-full rounded-md border border-rolling-stone-300 bg-white px-3 py-2 text-rolling-stone-900 dark:border-rolling-stone-700 dark:bg-rolling-stone-900 dark:text-rolling-stone-50" %>
  </div>

  <% if site_key.present? %>
    <div class="cf-turnstile" data-sitekey="<%= site_key %>" data-theme="auto"></div>
  <% end %>

  <%= f.submit "Send message", class: "rounded-md bg-smalt-700 px-4 py-2.5 text-sm font-medium text-smalt-50 hover:bg-smalt-800 dark:bg-smalt-400 dark:text-rolling-stone-950 dark:hover:bg-smalt-300" %>
<% end %>

<% if site_key.present? %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% end %>
