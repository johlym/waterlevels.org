<%# locals: stats: %>
<section class="admin-stats" aria-labelledby="admin-jobs-heading">
  <div class="section-header">
    <div>
      <p class="eyebrow">Jobs</p>
      <h2 id="admin-jobs-heading">Last finished</h2>
    </div>
  </div>

  <div class="stats-grid">
    <article>
      <p class="value value-sm">
        <%= stats[:last_tip_refresh_finished_at] ? "#{time_ago_in_words(stats[:last_tip_refresh_finished_at])} ago" : "—" %>
      </p>
      <p class="label">Latest tip sync</p>
      <p class="hint">
        <% if stats[:last_tip_refresh_state] %>
          State <%= stats[:last_tip_refresh_state].upcase %>
        <% elsif stats[:last_tip_refresh_finished_at] %>
          National
        <% else %>
          Not recorded yet
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm">
        <%= stats[:last_catalog_sync_at] ? "#{time_ago_in_words(stats[:last_catalog_sync_at])} ago" : "—" %>
      </p>
      <p class="label">Catalog sync</p>
      <p class="hint">
        <% if stats[:last_catalog_sync_state] %>
          State <%= stats[:last_catalog_sync_state].upcase %>
        <% elsif stats[:last_catalog_sync_at] %>
          National
        <% else %>
          Not recorded yet
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm">
        <%= stats[:last_flood_sync_at] ? "#{time_ago_in_words(stats[:last_flood_sync_at])} ago" : "—" %>
      </p>
      <p class="label">Flood stage sync</p>
      <p class="hint">
        <% if stats[:last_flood_sync_state] %>
          State <%= stats[:last_flood_sync_state].upcase %>
        <% elsif stats[:last_flood_sync_at] %>
          National
        <% else %>
          Not recorded yet
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm<%= " alert" if stats[:last_prune_gaps_alerted].to_i.positive? %>">
        <%= stats[:last_prune_at] ? "#{time_ago_in_words(stats[:last_prune_at])} ago" : "—" %>
      </p>
      <p class="label">Day-31 handoff + retention</p>
      <p class="hint">
        <% if stats[:last_prune_at] %>
          <%= number_with_delimiter(stats[:last_prune_usgs_ensured].to_i) %> USGS ·
          <%= number_with_delimiter(stats[:last_prune_derived].to_i) %> estimated ·
          <%= number_with_delimiter(stats[:last_prune_retrying].to_i) %> retrying ·
          <span class="<%= "alert" if stats[:last_prune_gaps_alerted].to_i.positive? %>">
            <%= number_with_delimiter(stats[:last_prune_gaps_alerted].to_i) %> gaps
          </span>
          · IV −<%= number_with_delimiter(stats[:last_prune_iv_deleted].to_i) %>
          <% if stats[:last_prune_iv_blocked].to_i.positive? %>
            (<%= number_with_delimiter(stats[:last_prune_iv_blocked].to_i) %> blocked)
          <% end %>
        <% else %>
          USGS-first ensure, then IV prune + Postgres daily drain
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm">
        <%= stats[:last_daily_archive_export_at] ? "#{time_ago_in_words(stats[:last_daily_archive_export_at])} ago" : "—" %>
      </p>
      <p class="label">Daily archive export</p>
      <p class="hint">
        <% if stats[:last_daily_archive_export_at] %>
          <%= number_with_delimiter(stats[:last_daily_archive_export_series].to_i) %> series ·
          <%= number_with_delimiter(stats[:last_daily_archive_export_points].to_i) %> points
        <% else %>
          Postgres → R2 / local shards
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm<%= " alert" if stats[:last_iv_repair_batch_workers].to_i.zero? && stats[:last_iv_repair_batch_enqueued].to_i.positive? %>">
        <%= stats[:last_iv_repair_batch_at] ? "#{time_ago_in_words(stats[:last_iv_repair_batch_at])} ago" : "—" %>
      </p>
      <p class="label">IV repair batch</p>
      <p class="hint">
        <% if stats[:last_iv_repair_batch_skip_reason].present? %>
          Skipped: <%= stats[:last_iv_repair_batch_skip_reason] %>
          <% if stats[:last_iv_repair_batch_workers] %>
            · <%= stats[:last_iv_repair_batch_workers] %> worker(s)
          <% end %>
        <% elsif stats[:last_iv_repair_batch_at] %>
          <%= number_with_delimiter(stats[:last_iv_repair_batch_enqueued].to_i) %> enqueued ·
          <%= number_with_delimiter(stats[:last_iv_repair_batch_candidates].to_i) %> candidates ·
          queue <%= number_with_delimiter(stats[:last_iv_repair_batch_queue_depth_after].to_i) %> ·
          <%= number_with_delimiter(stats[:last_iv_repair_batch_workers].to_i) %> worker(s)
        <% else %>
          Gap-fill lane on <code>iv_repair_worker</code>
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm">
        <%= stats[:last_iv_repair_at] ? "#{time_ago_in_words(stats[:last_iv_repair_at])} ago" : "—" %>
      </p>
      <p class="label">Last IV repair station</p>
      <p class="hint">
        <% if stats[:last_iv_repair_at] %>
          <%= stats[:last_iv_repair_site_number] %> ·
          <%= number_with_delimiter(stats[:last_iv_repair_continuous_upserted].to_i) %> points ·
          <%= stats[:last_iv_repair_elapsed_s] %>s
          <% if stats[:last_iv_repair_still_needs] %>
            · still needs repair
          <% end %>
        <% else %>
          Per-station continuous gap fetch
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm<%= " alert" if stats[:last_iv_scar_batch_workers].to_i.zero? && stats[:last_iv_scar_batch_enqueued].to_i.positive? %>">
        <%= stats[:last_iv_scar_batch_at] ? "#{time_ago_in_words(stats[:last_iv_scar_batch_at])} ago" : "—" %>
      </p>
      <p class="label">IV scar batch</p>
      <p class="hint">
        <% if stats[:last_iv_scar_batch_skip_reason].present? %>
          Skipped: <%= stats[:last_iv_scar_batch_skip_reason] %>
          <% if stats[:last_iv_scar_batch_workers] %>
            · <%= stats[:last_iv_scar_batch_workers] %> worker(s)
          <% end %>
        <% elsif stats[:last_iv_scar_batch_at] %>
          <%= number_with_delimiter(stats[:last_iv_scar_batch_enqueued].to_i) %> enqueued ·
          <%= number_with_delimiter(stats[:last_iv_scar_batch_candidates].to_i) %> candidates ·
          queue <%= number_with_delimiter(stats[:last_iv_scar_batch_queue_depth_after].to_i) %> ·
          <%= number_with_delimiter(stats[:last_iv_scar_batch_workers].to_i) %> worker(s)
        <% else %>
          Interior scar lane on <code>iv_repair_scar_worker</code>
        <% end %>
      </p>
    </article>

    <article>
      <p class="value value-sm">
        <%= stats[:last_iv_scar_at] ? "#{time_ago_in_words(stats[:last_iv_scar_at])} ago" : "—" %>
      </p>
      <p class="label">Last IV scar station</p>
      <p class="hint">
        <% if stats[:last_iv_scar_at] %>
          <%= stats[:last_iv_scar_site_number] %> ·
          <%= number_with_delimiter(stats[:last_iv_scar_continuous_upserted].to_i) %> points ·
          <%= stats[:last_iv_scar_elapsed_s] %>s
          <% if stats[:last_iv_scar_still_needs] %>
            · still needs scar repair
          <% end %>
        <% else %>
          Per-station interior gap fetch (key2)
        <% end %>
      </p>
    </article>
  </div>
</section>
