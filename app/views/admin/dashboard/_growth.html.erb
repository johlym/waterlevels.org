<%# locals: stats: %>
<section class="admin-stats" aria-labelledby="admin-growth-heading">
  <div class="section-header">
    <div>
      <p class="eyebrow">Growth</p>
      <h2 id="admin-growth-heading">Measurements &amp; tip freshness</h2>
      <% if stats[:inventory_computed_at] %>
        <p class="hint">
          Continuous 24h/7d from inventory Counters as of <%= time_ago_in_words(stats[:inventory_computed_at]) %> ago
          · tip freshness is live
        </p>
      <% else %>
        <p class="hint">Continuous 24h/7d pending inventory Counters · tip freshness is live</p>
      <% end %>
    </div>
  </div>

  <div class="stats-grid">
    <article>
      <p class="value"><%= number_with_delimiter(stats[:continuous_last_24h]) %></p>
      <p class="label">Continuous points (24h)</p>
      <p class="hint">
        By observed_at
        <% if stats[:implied_interval_minutes] %>
          · ≈ <%= number_with_precision(stats[:implied_interval_minutes], precision: 1, strip_insignificant_zeros: true) %> min spacing
          across <%= number_with_delimiter(stats[:recent_iv_series_count].to_i) %> selected series
        <% end %>
      </p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:continuous_last_7d]) %></p>
      <p class="label">Continuous points (7d)</p>
      <p class="hint">
        By observed_at
        <% if stats[:selected_series_count].to_i.positive? %>
          · <%= number_with_delimiter(stats[:selected_series_count]) %> selected series total
        <% end %>
      </p>
    </article>
  </div>

  <% freshness = stats[:tip_freshness] %>
  <% freshness_segments = [
    [ :current, "Current", "current" ],
    [ :h1_plus, "1+ Hour", "h1" ],
    [ :h6_plus, "6+ Hours", "h6" ],
    [ :h24_plus, "24+ Hours", "h24" ],
    [ :h72_plus, "72+ Hours", "h72" ],
    [ :stale, "1+ Week/Stale", "stale" ]
  ] %>
  <% freshness_total = freshness_segments.sum { |key, _, _| freshness[key].to_i } %>
  <div class="freshness-panel">
    <h3>Tip freshness</h3>
    <p class="hint">
      Active stations by latest_observed_at age
      <% if freshness_total.positive? %>
        · <%= number_with_delimiter(freshness_total) %> total
      <% end %>
    </p>
    <div
      class="freshness-stack"
      role="img"
      aria-label="Tip freshness distribution across <%= number_with_delimiter(freshness_total) %> active stations"
    >
      <% if freshness_total.positive? %>
        <% freshness_segments.each do |key, label, tone| %>
          <% count = freshness[key].to_i %>
          <% next if count.zero? %>
          <% pct = count * 100.0 / freshness_total %>
          <span
            class="segment <%= tone %>"
            style="width: <%= pct %>%"
            title="<%= label %>: <%= number_with_delimiter(count) %> (<%= number_with_precision(pct, precision: 1) %>%)"
          ></span>
        <% end %>
      <% else %>
        <span class="segment empty" style="width: 100%"></span>
      <% end %>
    </div>
    <ul class="freshness-legend">
      <% freshness_segments.each do |key, label, tone| %>
        <% count = freshness[key].to_i %>
        <% pct = freshness_total.positive? ? (count * 100.0 / freshness_total) : 0 %>
        <li>
          <span class="swatch <%= tone %>" aria-hidden="true"></span>
          <span class="name"><%= label %></span>
          <span class="meta"><%= number_with_delimiter(count) %></span>
          <span class="pct">(<%= number_with_precision(pct, precision: 1) %>%)</span>
        </li>
      <% end %>
    </ul>
  </div>

  <% alerts = stats[:email_alerts] || {} %>
  <div class="freshness-panel" style="margin-top: 1.5rem">
    <h3>Email alerts</h3>
    <% if alerts[:enabled] %>
      <div class="stats-grid">
        <article>
          <p class="value"><%= number_with_delimiter(alerts[:subscribers_verified]) %></p>
          <p class="label">Verified subscribers</p>
        </article>
        <article>
          <p class="value"><%= number_with_delimiter(alerts[:watches]) %></p>
          <p class="label">Station watches</p>
        </article>
        <article>
          <p class="value"><%= number_with_delimiter(alerts[:deliveries_sent_24h]) %></p>
          <p class="label">Deliveries sent (24h)</p>
          <p class="hint">
            Failed <%= number_with_delimiter(alerts[:deliveries_failed_24h]) %>
            · skipped <%= number_with_delimiter(alerts[:deliveries_skipped_24h]) %>
            · events <%= number_with_delimiter(alerts[:events_24h]) %>
          </p>
        </article>
      </div>
    <% else %>
      <p class="hint">Disabled (`ALERTS_ENABLED` off). Set env to enable subscription surfaces and jobs.</p>
    <% end %>
  </div>
</section>
