<%# locals: stats: %>
<section class="admin-stats" aria-labelledby="admin-health-heading">
  <div class="section-header">
    <div>
      <p class="eyebrow">Health</p>
      <h2 id="admin-health-heading">USGS keys, circuits &amp; Sidekiq</h2>
      <p class="section-lede">
        Tip/catalog uses <code>USGS_API_KEY</code>. History pins one key per
        purpose (continuous / daily / peaks / IV repair). Circuits open on a
        USGS 429 for the rest of the UTC hour — we do not mirror remaining USGS
        quota locally (that counter was unreliable). Sidekiq figures and circuits
        are live (not AdminCounters).
      </p>
    </div>
  </div>

  <%# Prefer live key/circuit status — cheap (ENV + cache flags) and avoids
      crashing on a stale section cache that predates :usgs_keys. %>
  <% keys = stats[:usgs_keys].presence || Usgs::HistoryKeyPool.dashboard_statuses %>
  <div class="budget-panel">
    <h3>API keys &amp; circuits</h3>
    <p class="hint">
      Open = parked after a 429 until the UTC hour rolls.
      Unset history keys fall back to the tip key.
    </p>
    <ul class="status-list key-status-list">
      <% ([ keys[:tip] ] + Array(keys[:history])).each do |row| %>
        <li>
          <span class="name">
            <%= row[:key] %>
            <% unless row[:configured] %>
              <span class="cell-hint">(unset<%= row[:fallback_to_tip] ? ", uses tip circuit" : "" %>)</span>
            <% end %>
          </span>
          <span class="meta">
            <%= row[:role] %>
            <% if row[:fallback_to_tip] && row[:effective_circuit_key].present? %>
              · effective <%= row[:effective_circuit_key] %>
            <% end %>
          </span>
          <span class="badge <%= row[:open] ? "bad" : "ok" %>">
            <%= row[:open] ? "Circuit open" : "Clear" %>
          </span>
        </li>
      <% end %>
      <li>
        <span class="name">history pool</span>
        <span class="meta">Any purpose still callable</span>
        <span class="badge <%= keys[:exhausted] ? "bad" : "ok" %>">
          <%= keys[:exhausted] ? "Exhausted" : "Available" %>
        </span>
      </li>
      <li>
        <span class="name">database</span>
        <span class="meta">Write path</span>
        <span class="badge <%= stats[:database_read_only] ? "bad" : "ok" %>">
          <%= stats[:database_read_only] ? "Read-only circuit" : "Writable" %>
        </span>
      </li>
    </ul>
  </div>

  <div class="health-grid">
    <article>
      <h3>Sidekiq</h3>
      <% if stats[:sidekiq][:error] %>
        <p class="hint"><%= stats[:sidekiq][:error] %></p>
      <% else %>
        <ul class="status-list">
          <li>
            <span class="name">Enqueued</span>
            <span class="meta"><%= number_with_delimiter(stats[:sidekiq][:enqueued]) %></span>
          </li>
          <li>
            <span class="name">Retries</span>
            <span class="meta"><%= number_with_delimiter(stats[:sidekiq][:retry_size]) %></span>
          </li>
          <li>
            <span class="name">Dead</span>
            <span class="meta"><%= number_with_delimiter(stats[:sidekiq][:dead_size]) %></span>
          </li>
          <li>
            <span class="name">Failed (lifetime)</span>
            <span class="meta"><%= number_with_delimiter(stats[:sidekiq][:failed]) %></span>
          </li>
        </ul>
        <% if stats[:sidekiq][:queues].present? %>
          <p class="hint queues">
            <% stats[:sidekiq][:queues].each do |name, size| %>
              <% workers = stats[:sidekiq].dig(:workers_by_queue, name).to_i %>
              <span class="<%= "alert" if %w[iv_repair iv_repair_scar].include?(name.to_s) && size.to_i.positive? && workers.zero? %>">
                <%= name %>: <%= number_with_delimiter(size) %>
                (<%= workers %> worker<%= workers == 1 ? "" : "s" %>)
              </span>
            <% end %>
          </p>
        <% end %>
        <% iv_depth = stats[:sidekiq][:iv_repair_queue_depth].to_i %>
        <% iv_workers = stats[:sidekiq][:iv_repair_workers].to_i %>
        <% if iv_depth.positive? && iv_workers.zero? %>
          <p class="hint alert">
            <code>iv_repair</code> has <%= number_with_delimiter(iv_depth) %> queued job(s)
            but no process is listening — scale <code>iv_repair_worker</code>.
          </p>
        <% end %>
        <% scar_depth = stats[:sidekiq][:iv_repair_scar_queue_depth].to_i %>
        <% scar_workers = stats[:sidekiq][:iv_repair_scar_workers].to_i %>
        <% if scar_depth.positive? && scar_workers.zero? %>
          <p class="hint alert">
            <code>iv_repair_scar</code> has <%= number_with_delimiter(scar_depth) %> queued job(s)
            but no process is listening — scale <code>iv_repair_scar_worker</code>.
          </p>
        <% end %>
      <% end %>
    </article>
  </div>
</section>
