<%# locals: stats: %>
<section class="admin-stats" aria-labelledby="admin-pipeline-heading">
  <div class="section-header">
    <div>
      <p class="eyebrow">Pipeline</p>
      <h2 id="admin-pipeline-heading">Backfill &amp; freshness</h2>
      <% if stats[:inventory_computed_at] %>
        <p class="hint">
          History / stale / NWPS Counters as of <%= time_ago_in_words(stats[:inventory_computed_at]) %> ago
          · IV repair counts from last batch scan
          · locks are live Redis SCAN
        </p>
      <% end %>
    </div>
  </div>

  <div class="stats-grid">
    <article>
      <p class="value<%= " alert" if stats[:stations_needing_iv_repair].to_i.positive? %>">
        <%= number_with_delimiter(stats[:stations_needing_iv_repair]) %>
      </p>
      <p class="label">Need IV repair (tip)</p>
      <p class="hint">
        <% if stats[:iv_repair_candidates_scanned_at] %>
          Last batch scan <%= time_ago_in_words(stats[:iv_repair_candidates_scanned_at]) %> ago ·
        <% else %>
          From last IV repair batch scan ·
        <% end %>
        <%= number_with_delimiter(stats[:iv_repair_locks].to_i) %> locked ·
        <%= number_with_delimiter(stats[:iv_repair_cooldowns].to_i) %> cooling
      </p>
    </article>

    <article>
      <p class="value<%= " alert" if stats[:stations_needing_iv_scar_repair].to_i.positive? %>">
        <%= number_with_delimiter(stats[:stations_needing_iv_scar_repair]) %>
      </p>
      <p class="label">Need IV scar repair</p>
      <p class="hint">
        <% if stats[:iv_scar_candidates_scanned_at] %>
          Last scar scan <%= time_ago_in_words(stats[:iv_scar_candidates_scanned_at]) %> ago ·
        <% else %>
          From last IV scar batch scan ·
        <% end %>
        Actionable interior holes in ~35d IV (key2). USGS-empty scars park until retry.
      </p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:stations_needing_deep_history]) %></p>
      <p class="label">Have ~1y, need 3y</p>
      <p class="hint">Year-ready (incl. R2 daily tip); waiting on deep daily R2 backfill</p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:stations_history_ready]) %></p>
      <p class="label">History ready (3y)</p>
      <p class="hint">Neither backlog column — deep daily in hot tip or archive</p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:stale_station_count]) %></p>
      <p class="label">Stale stations</p>
      <p class="hint">Active but no tip within <%= distance_of_time_in_words(MonitoringLocation::STALE_AFTER) %></p>
    </article>

    <article>
      <p class="value<%= " alert" if stats[:flood_alert_count].to_i.positive? %>"><%= number_with_delimiter(stats[:flood_alert_count]) %></p>
      <p class="label">Flood alerts</p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:updates_today]) %></p>
      <p class="label">Continuous updates today</p>
      <p class="hint">Pacific calendar day</p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:nwps_matched_count]) %></p>
      <p class="label">NWPS-matched stations</p>
    </article>

    <article>
      <p class="value"><%= number_with_delimiter(stats[:history_backfill_locks]) %></p>
      <p class="label">Active backfill locks</p>
      <p class="hint"><%= number_with_delimiter(stats[:history_backfill_cooldowns]) %> on cooldown</p>
    </article>
  </div>
</section>
