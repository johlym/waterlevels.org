<% content_for :title, "Admin | WaterLevels.org" %>

<main id="main" class="page-main admin-dashboard"
      data-controller="admin-sections"
      data-admin-sections-order-value="<%= AdminDashboardStats.section_load_order.to_json %>">
  <div class="admin-dashboard-chrome">
    <div class="section-header">
      <div>
        <p class="eyebrow">Ops</p>
        <h1 class="admin-title">Dashboard</h1>
      </div>
    </div>
  </div>

  <% [
    [ :core, "Network", "Core stats", "admin-core-heading", 5 ],
    [ :pipeline, "Pipeline", "Backfill & freshness", "admin-pipeline-heading", 7 ],
    [ :growth, "Growth", "Measurements & tip freshness", "admin-growth-heading", 2 ],
    [ :jobs, "Jobs", "Last finished", "admin-jobs-heading", 4 ],
    [ :states, "States", "Station data coverage", "admin-states-heading", 0 ],
    [ :health, "Health", "USGS keys, circuits & Sidekiq", "admin-health-heading", 3 ]
  ].each do |section, eyebrow, heading, heading_id, cards| %>
    <%= turbo_frame_tag "admin_section_#{section}",
          data: {
            admin_section: section,
            admin_sections_target: "frame",
            admin_sections_src: admin_dashboard_section_path(section: section)
          } do %>
      <%= render "admin/dashboard/section_skeleton",
            eyebrow: eyebrow,
            heading: heading,
            heading_id: heading_id,
            cards: cards,
            table: section == :states,
            freshness: section == :growth,
            health: section == :health,
            lede: section.in?(%i[states health]),
            value_sm: section == :jobs %>
    <% end %>
  <% end %>
</main>
