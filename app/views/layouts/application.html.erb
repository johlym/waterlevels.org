<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= display_meta_tags(public_meta_tags) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%# CSRF meta tags only when a session is enabled (contact form). Emitting
        them on cacheable pages would force a session cookie and CDN BYPASS. %>
    <%= csrf_meta_tags if csrf_meta_tags_enabled? %>
    <%= csp_meta_tag %>
    <%# Live gauge/map data — do not restore Turbo's in-memory page snapshots. %>
    <meta name="turbo-cache-control" content="no-cache">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <script src="https://cdn.usefathom.com/script.js" data-site="ZARCBYJB" defer></script>
    <%= yield :head %>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <%= yield %>
  </body>
</html>

