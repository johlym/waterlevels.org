<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WaterLevels.org</title>
    <style>
      /* Self-contained email styles — no external fonts, stylesheets, or assets. */
      body {
        margin: 0;
        padding: 16px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        color: #18181b;
        background-color: #ffffff;
      }

      p {
        margin: 0 0 16px;
      }

      a {
        color: #0891b2;
      }

      strong {
        font-weight: 600;
      }

      ul {
        margin: 0 0 16px;
        padding-left: 20px;
      }

      .muted {
        font-size: 13px;
        line-height: 1.5;
        color: #71717a;
      }

      .muted-small {
        font-size: 12px;
        line-height: 1.4;
        color: #a1a1aa;
      }

      .email-divider {
        border: none;
        border-top: 1px solid #e4e4e7;
        margin: 24px 0;
      }

      .digest-item {
        margin-bottom: 12px;
      }

      .digest-meta {
        color: #71717a;
      }
    </style>
  </head>

  <body>
    <%# Bento Liquid: strip open-pixel / click-proxy / UTM rewriting on send.
        Without these, Bento injects a remote open.gif (kodama.*) that triggers
        iOS Mail "Load Remote Content", and rewrites links with tracking params.
        Kept inside an HTML comment so any filter echo stays invisible. %>
    <!-- {{ "true" | disable_open }}{{ "true" | disable_click }}{{ "true" | disable_utms }} -->
    <%= yield %>
  </body>
</html>


