<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= display_meta_tags site: "WaterLevels.org", reverse: true, noindex: true, nofollow: true, icon: site_icon_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= csrf_meta_tags if csrf_meta_tags_enabled? %>
    <%= csp_meta_tag %>
    <meta name="turbo-cache-control" content="no-cache">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <script src="https://kit.fontawesome.com/6f9cca9c2b.js" crossorigin="anonymous"></script>
    <%= yield :head %>
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="app-shell">
      <%= render Navigation::AdminBarComponent.new(signed_in: Admin::Auth.signed_in?(session)) %>
      <% if flash[:notice].present? %>
        <p class="admin-flash admin-flash--notice" role="status"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="admin-flash admin-flash--alert" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
      <%= render Footer::ThinComponent.new %>
    </div>
  </body>
</html>
