<% location_name = display_location_name(@snapshot[:name]) %>
<% station_image = absolute_url(og_station_path(@snapshot[:site_number])) %>
<%# Blank site keeps the fitted station title inside the snippet width. %>
<% set_meta_tags(
  site: "",
  title: Seo.gauge_title(name: location_name, state_code: @snapshot[:state_code], kinds: @location.measurement_kinds),
  description: Seo.gauge_description(
    name: location_name,
    agency: @location.agency_label,
    county_name: @snapshot[:county_name],
    state_name: @snapshot[:state_name],
    kinds: @location.measurement_kinds
  ),
  og: { image: { _: station_image } },
  twitter: { image: station_image }
) %>
<% content_for :head do %>
  <%= json_ld_tag(breadcrumb_json_ld(gauge_breadcrumbs(@snapshot, location_name))) %>
<% end %>
<% measurements = Array(@snapshot[:measurements]) %>
<%
  network = @snapshot[:network] || @snapshot["network"] || {}
  upstream = Array(network[:upstream] || network["upstream"]).reject { |node| related_station_stale?(node) }
  downstream = Array(network[:downstream] || network["downstream"]).reject { |node| related_station_stale?(node) }
  nearby = Array(@snapshot[:nearby]).reject { |node| related_station_stale?(node) }
  current_node = {
    site_number: @snapshot[:site_number],
    name: location_name,
    stale: @snapshot[:stale],
    measurements: measurements
  }
%>

<div
  class="app-shell"
  data-controller="parameter-toggle temperature-unit hydrograph"
  data-hydrograph-url-value="<%= api_gauge_observations_path(@snapshot[:site_number]) %>"
  data-hydrograph-measurements-value="<%= ERB::Util.json_escape(measurements.to_json) %>"
  data-hydrograph-flood-stages-value="<%= ERB::Util.json_escape((@snapshot[:flood_stages] || @snapshot["flood_stages"] || {}).to_json) %>"
  data-hydrograph-time-zone-value="<%= @snapshot[:time_zone_identifier] %>"
  data-hydrograph-time-zone-label-value="<%= @snapshot[:time_zone] %>"
  data-hydrograph-daily-only-value="<%= @location.daily_only? %>"
  data-hydrograph-default-range-value="<%= @location.default_chart_range %>"
  data-hydrograph-data-provider-value="<%= @location.data_provider %>"
  data-temperature-unit-url-value="<%= temperature_unit_path %>"
>
  <%= render Navigation::BarComponent.new %>
  <main id="main" class="page-main">
    <header class="gauge-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol role="list">
          <li><%= link_to "Map", root_path %></li>
          <li class="sep" aria-hidden="true">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </li>
          <li>
            <%= link_to @snapshot[:state_name].presence || @snapshot[:state_code].upcase, state_gauges_path(@snapshot[:state_code]) %>
          </li>
          <% if @snapshot[:county_name].present? %>
            <% county_label = display_county_name(@snapshot[:county_name]) %>
            <li class="sep" aria-hidden="true">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </li>
            <li>
              <%= link_to county_label, state_gauges_path(@snapshot[:state_code], anchor: directory_group_anchor(county_label)) %>
            </li>
          <% end %>
        </ol>
      </nav>

      <div class="identity">
        <h1><%= location_name %></h1>
      </div>
    </header>

    <div class="gauge-split<%= " gauge-split--pair" if AlertsConfig.enabled? %>">
      <aside class="station-meta">
        <% flood_category = @snapshot[:flood_category] || @snapshot["flood_category"] %>
        <% flood_label = @snapshot[:flood_category_label] || @snapshot["flood_category_label"] %>
        <% approval = measurements.dig(0, :approval_status) || measurements.dig(0, "approval_status") %>
        <div class="meta-grid">
          <div>
            <p class="label">Flood category</p>
            <p class="value">
              <% if flood_category.present? %>
                <%= annotate_glossary_terms(flood_label.presence || flood_category.to_s.humanize) %>
              <% else %>
                No flood stage data
              <% end %>
            </p>
          </div>
          <% if approval.present? %>
            <div>
              <p class="label">Data status</p>
              <p class="value"><%= annotate_glossary_terms(approval) %></p>
            </div>
          <% end %>
          <div>
            <p class="label">Station ID</p>
            <p class="value"><%= @snapshot[:site_number] %></p>
          </div>
          <div>
            <p class="label">Coordinates</p>
            <p class="value">
              <% lat = @snapshot[:latitude].to_f %>
              <% lon = @snapshot[:longitude].to_f %>
              <%= number_with_precision(lat.abs, precision: 4) %>° <%= lat >= 0 ? "N" : "S" %>,
              <%= number_with_precision(lon.abs, precision: 4) %>° <%= lon >= 0 ? "E" : "W" %>
            </p>
          </div>
          <% if @snapshot[:county_name].present? %>
            <div>
              <p class="label">County</p>
              <p class="value"><%= display_county_name(@snapshot[:county_name]) %></p>
            </div>
          <% end %>
          <div>
            <p class="label">Last updated</p>
            <p class="value"><%= display_timestamp(@snapshot[:latest_observed_at], time_zone: @snapshot[:time_zone_identifier] || @snapshot[:time_zone], state_code: @snapshot[:state_code]) %></p>
          </div>
          <% stages = @snapshot[:flood_stages] || @snapshot["flood_stages"] || {} %>
          <% action_ft = stages[:action] || stages["action"] %>
          <% minor_ft = stages[:minor] || stages["minor"] %>
          <% moderate_ft = stages[:moderate] || stages["moderate"] %>
          <% major_ft = stages[:major] || stages["major"] %>
          <% if action_ft.present? || minor_ft.present? || moderate_ft.present? || major_ft.present? %>
            <div class="span-2">
              <p class="label">NWS flood stages</p>
              <p class="value flood-stages">
                <% bits = [] %>
                <% bits << "Action #{display_gauge_value(action_ft)} ft" if action_ft.present? %>
                <% bits << "Minor #{display_gauge_value(minor_ft)} ft" if minor_ft.present? %>
                <% bits << "Mod #{display_gauge_value(moderate_ft)} ft" if moderate_ft.present? %>
                <% bits << "Major #{display_gauge_value(major_ft)} ft" if major_ft.present? %>
                <%= bits.join(" · ") %>
              </p>
            </div>
          <% end %>
        </div>
      </aside>

      <% if AlertsConfig.enabled? %>
        <%= render "gauges/alert_signup" %>
      <% end %>
    </div>

    <%= render Gauges::MeasurementsComponent.new(measurements: measurements) %>

    <section id="graph-panel" class="section-block" aria-labelledby="graph-heading">
      <div class="section-head">
        <h2 id="graph-heading">Historical trends</h2>
        <div class="history-controls">
          <div class="segmented" role="group" aria-label="Time range">
            <% ranges = @location.chart_ranges
               default_range = @location.default_chart_range
               range_labels = { "7d" => "7 Days", "30d" => "30 Days", "1y" => "1 Year", "3y" => "3 Years", "10y" => "10 Years" } %>
            <% ranges.each do |range| %>
              <button
                type="button"
                data-action="hydrograph#setRange"
                data-hydrograph-range-param="<%= range %>"
                data-hydrograph-target="rangeButton"
                aria-pressed="<%= range == default_range %>"
              ><%= range_labels.fetch(range, range) %></button>
            <% end %>
          </div>
          <div class="segmented" role="group" aria-label="History view">
            <button
              type="button"
              data-action="hydrograph#setView"
              data-hydrograph-view-param="chart"
              data-hydrograph-target="viewButton"
              aria-pressed="true"
            >Chart</button>
            <button
              type="button"
              data-action="hydrograph#setView"
              data-hydrograph-view-param="table"
              data-hydrograph-target="viewButton"
              aria-pressed="false"
            >Table</button>
          </div>
          <button type="button" class="toolbar-btn" data-action="hydrograph#exportCsv">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            Export CSV
          </button>
        </div>
      </div>
      <% if @location.usgs? && @location.missing_year_history? %>
        <div class="history-callout" role="status">
          <p>
            Full-year history is still loading for this station. Shorter ranges are available now;
            the 1 Year chart will fill in as we finish backfilling from USGS.
          </p>
        </div>
      <% elsif @location.usgs? && (unavailable = @location.daily_history_unavailable_labels).any? %>
        <div class="history-callout" role="status">
          <p>
            USGS does not publish daily history for <%= unavailable.to_sentence %>.
            Use 30 Days or shorter for continuous readings; other measurements may still have 1 Year / 3 Years charts.
          </p>
        </div>
      <% end %>
      <% if @location.usgs? && @location.known_missing_usgs_iv? %>
        <div class="history-callout" role="status">
          <p>
            USGS is missing data that would fill a gap in this station's recent readings.
            The hashed stretch on the chart is a real outage, not a hole in our archive.
            <% recheck_at = @location.usgs_iv_gap_recheck_at %>
            <% if recheck_at %>
              We'll check USGS again <%= display_timestamp(recheck_at, time_zone: @snapshot[:time_zone_identifier] || @snapshot[:time_zone], state_code: @snapshot[:state_code]) %>.
            <% else %>
              We'll check USGS again after the retry window.
            <% end %>
          </p>
        </div>
      <% end %>
      <% if @location.data_provider == DataProviders::USBR && @location.agency_url.present? %>
        <div class="history-callout" role="status">
          <p>
            Elevation is published daily by the U.S. Bureau of Reclamation (RISE).
            Vertical datum at Hoover Dam / Lake Mead is USGS 1912 (Power House Datum).
            See the
            <%= link_to "official RISE location page", @location.agency_url, rel: "noopener noreferrer", target: "_blank" %>
            for provenance.
          </p>
        </div>
      <% elsif @location.data_provider == DataProviders::USACE && @location.agency_url.present? %>
        <% usace_entry = Usace::ProjectCatalog.find_by_site_number(@location.site_number) %>
        <div class="history-callout" role="status">
          <p>
            Elevation is published by the U.S. Army Corps of Engineers (CWMS Data API).
            <% if usace_entry&.datum_note.present? %>
              Vertical datum: <%= usace_entry.datum_note %>.
            <% end %>
            See the
            <%= link_to "official CWMS location record", @location.agency_url, rel: "noopener noreferrer", target: "_blank" %>
            for provenance.
          </p>
        </div>
      <% elsif @location.data_provider == DataProviders::NWPS && @location.agency_url.present? %>
        <div class="history-callout" role="status">
          <p>
            Observed stage is published by the National Weather Service
            National Water Prediction Service (NWPS). This gauge has no USGS
            site id in NWPS — WaterLevels.org shows it as an NWS monitoring point.
            See the
            <%= link_to "official NWPS gauge page", @location.agency_url, rel: "noopener noreferrer", target: "_blank" %>
            for provenance.
          </p>
        </div>
      <% elsif @location.data_provider == DataProviders::CDEC && @location.agency_url.present? %>
        <% cdec_entry = Cdec::ReservoirCatalog.find_by_site_number(@location.site_number) %>
        <div class="history-callout" role="status">
          <p>
            Elevation is published daily by the California Data Exchange Center (CDEC).
            <% if cdec_entry&.datum_note.present? %>
              <%= cdec_entry.datum_note %>.
            <% end %>
            See the
            <%= link_to "official CDEC station page", @location.agency_url, rel: "noopener noreferrer", target: "_blank" %>
            for provenance.
          </p>
        </div>
      <% end %>
      <div data-hydrograph-target="chartView">
        <div class="chart-panel">
          <div class="pad">
            <div class="chart-legend" data-hydrograph-target="legend"></div>
            <div class="canvas-wrap">
              <canvas data-hydrograph-target="canvas" role="img" aria-label="Station trend chart. Switch to the Table view for accessible hourly readings."></canvas>
            </div>
            <p class="aside estimated-footnote" data-hydrograph-target="estimatedNote" hidden>
              Estimated daily mean from continuous data (USGS daily unavailable).
            </p>
            <div class="period-stats" data-hydrograph-target="stats"></div>
          </div>
        </div>
      </div>
      <div id="history-panel" data-hydrograph-target="tableView" hidden>
        <div class="history-toolbar">
          <label class="sr-only" for="history-day-select">Day</label>
          <select
            id="history-day-select"
            class="day-select"
            data-hydrograph-target="daySelect"
            data-action="change->hydrograph#selectDay"
          ></select>
        </div>
        <div class="measurements-table" data-hydrograph-target="history"></div>
      </div>
    </section>

    <%= render "gauges/related_stations",
          upstream: upstream,
          downstream: downstream,
          nearby: nearby,
          current_node: current_node %>

    <p class="usgs-note">
      <% agency_href = @snapshot[:agency_url].presence || @snapshot[:usgs_url] %>
      <% agency_name = @snapshot[:agency_label].presence || "U.S. Geological Survey" %>
      Data courtesy of the <% if agency_href.present? %><%= link_to agency_name, agency_href, rel: "noopener noreferrer", target: "_blank" %><% else %><%= agency_name %><% end %><% if @snapshot[:agency_credit].present? && @snapshot[:agency_credit] != agency_name %> and <%= @snapshot[:agency_credit] %><% end %>.
    </p>
  </main>
  <%= render Footer::ThinComponent.new %>
</div>
