<% content_for :title, "#{@snapshot[:name]} Water Level & Flow | #{@snapshot[:state_code].upcase} | WaterLevels.org" %>
<% content_for :meta_description, "Current water level, flow, and temperature for #{@snapshot[:name]} from USGS monitoring data." %>
<% measurements = Array(@snapshot[:measurements]) %>

<div
  class="flex min-h-dvh flex-col"
  data-controller="parameter-toggle temperature-unit hydrograph"
  data-hydrograph-url-value="<%= api_gauge_observations_path(@snapshot[:site_number]) %>"
  data-hydrograph-measurements-value="<%= measurements.to_json %>"
  data-temperature-unit-url-value="<%= temperature_unit_path %>"
>
  <%= render Navigation::BarComponent.new %>
  <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3">
      <nav aria-label="Breadcrumb">
        <ol role="list" class="flex flex-wrap items-center gap-2 text-base text-rolling-stone-600 dark:text-rolling-stone-400 sm:text-sm">
          <li><%= link_to "Map", root_path, class: "hover:text-rolling-stone-950 dark:hover:text-white" %></li>
          <li aria-hidden="true" class="text-rolling-stone-300 dark:text-rolling-stone-600">/</li>
          <li>
            <%= link_to @snapshot[:state_name].presence || @snapshot[:state_code].upcase, state_gauges_path(@snapshot[:state_code]), class: "hover:text-rolling-stone-950 dark:hover:text-white" %>
          </li>
          <% if @snapshot[:county_name].present? %>
            <li aria-hidden="true" class="text-rolling-stone-300 dark:text-rolling-stone-600">/</li>
            <li><%= @snapshot[:county_name] %> County</li>
          <% end %>
        </ol>
      </nav>

      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-3xl">
          <h1 class="text-balance text-3xl font-semibold tracking-tight text-rolling-stone-950 dark:text-white sm:text-4xl"><%= @snapshot[:name] %></h1>
          <p class="mt-2 text-base text-pretty text-rolling-stone-600 dark:text-rolling-stone-400 sm:text-sm">
            Updated <%= @snapshot[:latest_observed_at] || "—" %>
            <% approval = measurements.dig(0, :approval_status) || measurements.dig(0, "approval_status") %>
            <% if approval.present? %>
              · <%= approval %>
            <% end %>
            · Site <%= @snapshot[:site_number] %>
          </p>
        </div>
        <% if @snapshot[:stale] %>
          <div class="rounded-full bg-amber-50 px-3 py-1 text-base font-medium text-amber-800 outline outline-amber-600/15 dark:bg-amber-400/10 dark:text-amber-200 dark:outline-amber-400/20 sm:text-sm">
            Stale — older than 1 week
          </div>
        <% end %>
      </div>
    </div>

    <%= render Gauges::MeasurementsComponent.new(measurements: measurements) %>

    <section id="graph-panel" class="mt-12" aria-labelledby="graph-heading">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 id="graph-heading" class="text-base font-semibold text-rolling-stone-950 dark:text-white">History</h2>
        <div class="inline-flex rounded-lg bg-rolling-stone-950/5 p-1 dark:bg-white/5" role="group" aria-label="Time range">
          <% %w[24h 7d 30d 1y].each do |range| %>
            <button
              type="button"
              class="rounded-md px-3 py-1.5 text-base font-medium text-rolling-stone-600 hover:text-rolling-stone-950 aria-pressed:bg-white aria-pressed:text-rolling-stone-950 aria-pressed:shadow-sm dark:text-rolling-stone-300 dark:hover:text-white dark:aria-pressed:bg-rolling-stone-800 dark:aria-pressed:text-white sm:text-sm"
              data-action="hydrograph#setRange"
              data-hydrograph-range-param="<%= range %>"
              data-hydrograph-target="rangeButton"
              aria-pressed="<%= range == "7d" %>"
            ><%= range %></button>
          <% end %>
        </div>
      </div>
      <div class="mt-4 overflow-hidden rounded-xl bg-white outline outline-rolling-stone-950/10 dark:bg-rolling-stone-950 dark:outline-white/10">
        <div class="h-80 p-4 sm:p-6">
          <canvas class="size-full" data-hydrograph-target="canvas"></canvas>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="history-heading">
      <h2 id="history-heading" class="text-base font-semibold text-rolling-stone-950 dark:text-white">Recent observations</h2>
      <div class="mt-4 overflow-hidden rounded-xl outline outline-rolling-stone-950/10 dark:outline-white/10">
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-base sm:text-sm">
            <thead class="bg-rolling-stone-50 dark:bg-white/5">
              <tr>
                <th class="px-4 py-3 font-medium text-rolling-stone-600 dark:text-rolling-stone-300 sm:px-6">Time</th>
                <th class="px-4 py-3 font-medium text-rolling-stone-600 dark:text-rolling-stone-300 sm:px-6">Value</th>
              </tr>
            </thead>
            <tbody data-hydrograph-target="tableBody" class="divide-y divide-rolling-stone-950/5 bg-white dark:divide-white/5 dark:bg-rolling-stone-950"></tbody>
          </table>
        </div>
      </div>
    </section>

    <% nearby = Array(@snapshot[:nearby]) %>
    <% if nearby.any? %>
      <section class="mt-12" aria-labelledby="nearby-heading">
        <h2 id="nearby-heading" class="text-base font-semibold text-rolling-stone-950 dark:text-white">Nearby locations</h2>
        <ul role="list" class="mt-4 divide-y divide-rolling-stone-950/5 rounded-xl outline outline-rolling-stone-950/10 dark:divide-white/5 dark:outline-white/10">
          <% nearby.each do |n| %>
            <li>
              <%= link_to n[:path] || n["path"], class: "flex items-center justify-between gap-4 px-4 py-4 hover:bg-rolling-stone-50 dark:hover:bg-white/5 sm:px-6" do %>
                <div class="text-base font-medium text-rolling-stone-950 dark:text-white sm:text-sm"><%= n[:name] || n["name"] %></div>
                <div class="text-base text-smalt-700 dark:text-smalt-300 sm:text-sm">View</div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <p class="mt-12 text-base text-rolling-stone-500 dark:text-rolling-stone-400 sm:text-sm">
      Official USGS page:
      <%= link_to @snapshot[:usgs_url], @snapshot[:usgs_url], class: "font-medium text-smalt-700 underline hover:text-smalt-800 dark:text-smalt-300 dark:hover:text-smalt-200", rel: "noopener noreferrer", target: "_blank" %>
      (may include cooperator information)
    </p>
  </main>
  <%= render Footer::ThinComponent.new %>
</div>
