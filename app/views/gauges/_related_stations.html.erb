<%
  upstream = Array(local_assigns[:upstream])
  downstream = Array(local_assigns[:downstream])
  nearby = Array(local_assigns[:nearby])
  current_node = local_assigns[:current_node]
  has_stream = upstream.any? || downstream.any?
  has_nearby = nearby.any?
%>
<% if has_stream || has_nearby %>
  <section class="section-block related-stations" aria-labelledby="related-heading">
    <div class="section-head">
      <div>
        <h2 id="related-heading">Related stations</h2>
        <p class="aside">Jump upstream, downstream, or to another nearby gauge</p>
      </div>
      <%= link_to root_path, class: "section-link" do %>
        View all on map
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      <% end %>
    </div>

    <% payload = related_map_payload(upstream: upstream, downstream: downstream, nearby: nearby, current: current_node) %>
    <% if payload %>
      <% roles = payload[:stations].map { |station| station[:role] } %>
      <div
        class="related-map"
        data-controller="related-map"
        data-related-map-payload-value="<%= ERB::Util.json_escape(payload.to_json) %>"
        data-related-map-carto-api-key-value="<%= ENV.fetch("CARTO_API_KEY", "") %>"
        data-related-map-maplibre-worker-url-value="<%= asset_path("maplibre-gl-worker.js") %>"
      >
        <div class="related-map-frame">
          <div
            data-related-map-target="canvas"
            class="related-map-canvas"
            role="img"
            aria-label="Map of this station and related gauges. Station links are in the lists below."
          ></div>
          <div class="related-map-chrome">
            <ul class="related-map-legend" aria-label="Map legend">
              <li><span class="swatch swatch-current" aria-hidden="true"></span> This station</li>
              <% if roles.include?("upstream") %>
                <li><span class="swatch swatch-upstream" aria-hidden="true"></span> Upstream</li>
              <% end %>
              <% if roles.include?("downstream") %>
                <li><span class="swatch swatch-downstream" aria-hidden="true"></span> Downstream</li>
              <% end %>
              <% if roles.include?("nearby") %>
                <li><span class="swatch swatch-nearby" aria-hidden="true"></span> Nearby</li>
              <% end %>
            </ul>
            <div class="related-map-tools">
              <button type="button" data-action="related-map#zoomIn" aria-label="Zoom in">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
              </button>
              <button type="button" data-action="related-map#zoomOut" aria-label="Zoom out">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="related-columns<%= " related-columns--single" unless has_stream && has_nearby %>">
      <% if has_stream %>
        <div class="related-column">
          <h3 id="network-heading">On this stream</h3>
          <ul role="list" class="related-list">
            <% upstream.reverse_each do |node| %>
              <li>
                <%= render "gauges/related_row", node: node, direction: "upstream" %>
              </li>
            <% end %>
            <li>
              <%= render "gauges/related_row", node: current_node, current: true %>
            </li>
            <% downstream.each do |node| %>
              <li>
                <%= render "gauges/related_row", node: node, direction: "downstream" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if has_nearby %>
        <div class="related-column">
          <h3 id="nearby-heading">Nearby stations</h3>
          <ul role="list" class="related-list">
            <% nearby.each do |node| %>
              <li>
                <%= render "gauges/related_row", node: node, show_distance: true %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
