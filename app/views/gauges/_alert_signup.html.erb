<% site_key = ENV.fetch("TURNSTILE_SITE_KEY", Contact::FormComponent::SITE_KEY) %>
<% turnstile_required = ENV["TURNSTILE_SECRET"].present? %>
<section id="alerts-cta" class="gauge-alert-card" aria-labelledby="alerts-cta-heading">
  <div class="gauge-alert-copy">
    <h2 id="alerts-cta-heading">Get email alerts</h2>
    <p>Optional flood-category and threshold emails for this station. Confirm by email; unsubscribe anytime.</p>
  </div>

  <%= form_with url: subscriptions_path, method: :post, class: "contact-form gauge-alert-form", data: { turbo: false, controller: "subscription-timezone" } do %>
    <%= invisible_captcha :subtitle %>
    <%= hidden_field_tag :monitoring_location_id, @location.id %>
    <%= hidden_field_tag :time_zone, "", data: { subscription_timezone_target: "hidden" } %>

    <div class="gauge-alert-row">
      <div class="field">
        <label for="gauge-alert-email">Email address</label>
        <%= email_field_tag :email, nil, id: "gauge-alert-email", required: true, autocomplete: "email", placeholder: "you@example.com" %>
      </div>
      <%= submit_tag "Subscribe", class: "submit" %>
    </div>

    <div class="gauge-alert-extras">
      <div class="checkbox-field">
        <label class="checkbox-label">
          <%= check_box_tag :digest_enabled, "1", true, id: "gauge-alert-digest" %>
          Include in daily digest
        </label>
      </div>
      <p class="aside">
        Time zone: <span data-subscription-timezone-target="label">detecting…</span>
        <button type="button" class="text-link" data-subscription-timezone-target="changeButton" data-action="subscription-timezone#showSelect">Change</button>
      </p>
    </div>
    <%= select_tag :time_zone_select,
          options_for_select(SubscriberTimeZones.options_for_select),
          id: "gauge-alert-time-zone",
          hidden: true,
          data: {
            subscription_timezone_target: "select",
            action: "change->subscription-timezone#selectChanged"
          } %>

    <% if turnstile_required %>
      <div
        class="cf-turnstile turnstile"
        data-sitekey="<%= site_key %>"
        data-theme="dark"
        data-action="subscription-gauge-signup"
        aria-label="Bot check"
      ></div>
    <% end %>

    <p class="aside">
      Already watching?
      <%= link_to "Manage email alerts", subscriptions_path, class: "text-link" %>.
    </p>
  <% end %>
</section>
<% if turnstile_required %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% end %>
