<%
  upstream = local_assigns[:upstream]
  downstream = local_assigns[:downstream]
  current_name = local_assigns[:current_name]
  up_fields = upstream && related_station_fields(upstream)
  down_fields = downstream && related_station_fields(downstream)
%>
<nav class="stream-hop" aria-label="Stations on this stream">
  <% if up_fields %>
    <%= link_to up_fields[:path], class: "hop hop-up" do %>
      <span class="hop-kicker">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Upstream
      </span>
      <span class="hop-name"><%= up_fields[:name] %></span>
    <% end %>
  <% else %>
    <span class="hop hop-up hop-empty">
      <span class="hop-kicker">Upstream</span>
      <span class="hop-name">None indexed</span>
    </span>
  <% end %>

  <span class="hop hop-here" aria-current="page">
    <span class="hop-kicker">This station</span>
    <span class="hop-name"><%= current_name %></span>
  </span>

  <% if down_fields %>
    <%= link_to down_fields[:path], class: "hop hop-down" do %>
      <span class="hop-kicker">
        Downstream
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </span>
      <span class="hop-name"><%= down_fields[:name] %></span>
    <% end %>
  <% else %>
    <span class="hop hop-down hop-empty">
      <span class="hop-kicker">Downstream</span>
      <span class="hop-name">None indexed</span>
    </span>
  <% end %>
</nav>
