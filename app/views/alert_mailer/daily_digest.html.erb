<p>Your daily WaterLevels.org digest:</p>
<% if @snapshots.blank? %>
  <p>No watched stations to report right now.</p>
<% else %>
  <ul>
    <% @snapshots.each do |snap| %>
      <%
        name = snap[:name] || snap["name"] || "Station"
        category = snap[:flood_category_label] || snap["flood_category_label"] || snap[:flood_category] || snap["flood_category"]
        level = snap[:water_level] || snap["water_level"]
        level_unit = snap[:water_level_unit] || snap["water_level_unit"]
        discharge = snap[:discharge] || snap["discharge"]
        discharge_unit = snap[:discharge_unit] || snap["discharge_unit"]
        url = snap[:url] || snap["url"]
        site = snap[:site_number] || snap["site_number"]
      %>
      <li class="digest-item">
        <% if url.present? %>
          <strong><a href="<%= url %>"><%= name %></a></strong>
        <% else %>
          <strong><%= name %></strong>
        <% end %>
        <% if site.present? %>
          <span class="digest-meta">(<%= email_site_number(site) %>)</span>
        <% end %>
        <% if level.present? %>
          — gage height: <%= level %><%= " #{level_unit}" if level_unit.present? %>
        <% end %>
        <% if discharge.present? %>
          — discharge: <%= discharge %><%= " #{discharge_unit}" if discharge_unit.present? %>
        <% end %>
        <% if category.present? %>
          — flood: <%= category.to_s.tr("_", " ") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
<%= render "footer" %>
