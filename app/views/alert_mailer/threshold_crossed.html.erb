<% name = @location&.display_name.presence || "Station" %>
<% param_label = (@parameter || "reading").to_s.tr("_", " ") %>
<p>
  <strong><%= name %></strong>: <%= param_label %>
  crossed <%= (@op || "above").to_s %>
  <strong><%= @threshold %><%= " #{@unit}" if @unit.present? %></strong>
  (observed <%= @value %><%= " #{@unit}" if @unit.present? %>)
  <% if @observed_at.present? %>
    at <%= @observed_at %>
  <% end %>.
</p>
<% if @station_url.present? %>
  <p><a href="<%= @station_url %>">View station on WaterLevels.org</a></p>
<% end %>
<%= render "footer" %>
