<% name = @location&.display_name.presence || "Station" %>
<p>
  <% if @station_url.present? %>
    <strong><a href="<%= @station_url %>"><%= name %></a></strong>
  <% else %>
    <strong><%= name %></strong>
  <% end %>
  flood category changed.
</p>
<p>
  From <strong><%= (@from_category || "unknown").to_s.tr("_", " ") %></strong>
  to <strong><%= (@to_category || "unknown").to_s.tr("_", " ") %></strong>
  <% if @observed_at.present? %>
    at <%= @observed_at %>
  <% end %>.
</p>
<p class="muted">
  This is an informational category from NWS NWPS via WaterLevels.org — not an official
  flood watch or warning. For watches/warnings use
  <a href="https://water.noaa.gov/">water.noaa.gov</a>.
</p>
<% if @station_url.present? %>
  <p><a href="<%= @station_url %>">View station on WaterLevels.org</a></p>
<% end %>
<%= render "footer" %>
