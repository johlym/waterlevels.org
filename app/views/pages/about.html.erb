<% content_for :title, "About | WaterLevels.org" %>
<div class="flex min-h-dvh flex-col">
  <%= render Navigation::BarComponent.new %>
  <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-balance text-3xl font-semibold tracking-tight text-rolling-stone-950 dark:text-white sm:text-4xl">About WaterLevels.org</h1>
    <div class="mt-6 space-y-4 text-base text-pretty text-rolling-stone-600 dark:text-rolling-stone-300">
      <p>WaterLevels.org maps USGS monitoring locations and shows current water level, streamflow, and water temperature with recent history.</p>
      <p>Data is U.S. government work from the USGS Water Data APIs. Provisional values can change as USGS reviews and approves observations.</p>
    </div>
  </main>
  <%= render Footer::ThinComponent.new %>
</div>
