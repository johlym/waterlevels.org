<% content_for :title, "Privacy | WaterLevels.org" %>
<div class="flex min-h-dvh flex-col">
  <%= render Navigation::BarComponent.new %>
  <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
    <h1 class="text-3xl font-semibold tracking-tight">Privacy</h1>
    <p class="mt-4 text-rolling-stone-700 dark:text-rolling-stone-300">We use a small preference cookie for temperature units (°F/°C). Map location is requested only if you choose “Use my location” and is not sent to our servers. Gauge pages are cached publicly.</p>
  </main>
  <%= render Footer::ThinComponent.new %>
</div>
