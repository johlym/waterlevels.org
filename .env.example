# Tip/current + catalog sync (hourly latest, Sunday catalog, bootstrap).
USGS_API_KEY=
# Dedicated history backfill keys (HistoryIngestion). Round-robined; each has its
# own USGS 1000 req/hr budget and rate-limit circuit. Leave unset locally to
# fall back to USGS_API_KEY.
USGS_API_HISTORY_1_KEY=
USGS_API_HISTORY_2_KEY=
USGS_REQUEST_PAUSE_MS=100
NWPS_REQUEST_PAUSE_MS=100
# Soft-cap per API key before opening the rate-limit circuit for the rest of the
# UTC hour (USGS hard limit is 1000). Live counters are in Redis and shown on /admin.
# USGS_HOURLY_SOFT_CAP=980
# Station slots *per available history key* (default 50 ≈ cold 1y work at ~1000 req/hr/key).
# Total phase-1 enqueue ≈ HISTORY_BACKFILL_BATCH × available history keys, further
# capped by remaining hourly request budget.
HISTORY_BACKFILL_BATCH=50
# Per-key ceiling for 3y daily deep fills. Actual deep slots also shrink to the
# request budget left after phase-1 (set 0 to pause deep). Default 400/key.
HISTORY_DEEP_BACKFILL_BATCH=400
# Skip HistoryBackfillBatchJob when the Sidekiq backfill queue already has this
# many jobs (avoids double-booking remaining budget on the */10 cron). Set 0 to disable.
# HISTORY_BACKFILL_QUEUE_BUSY=5
# Optional planning costs for the request-budget math (defaults 20 / 2).
# HISTORY_PHASE1_REQUESTS_PER_STATION=20
# HISTORY_DEEP_REQUESTS_PER_STATION=2

REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=
SENTRY_DSN=
# OpenTelemetry → Honeycomb (OTLP). Leave unset to disable export locally.
# The OTel SDK does NOT read HONEYCOMB_API_KEY — set OTEL_EXPORTER_OTLP_HEADERS.
# AR/PG/Redis/Net::HTTP auto-instrumentation is off in config/initializers/opentelemetry.rb
# (bulk ingest event volume); no extra OTEL_* env needed for that.
OTEL_SERVICE_NAME=waterlevels
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_HONEYCOMB_API_KEY
# Optional: HONEYCOMB_API_KEY is documented for ops clarity; wire it into
# OTEL_EXPORTER_OTLP_HEADERS (above) or export both with the same value.
HONEYCOMB_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
CONTACT_TO_EMAIL=hello@waterlevels.org
MAIL_FROM=WaterLevels.org <hello@waterlevels.org>
APP_HOST=waterlevels.org
BENTO_SITE_UUID=
BENTO_PUBLISHABLE_KEY=
BENTO_SECRET_KEY=
# Optional: purge Cloudflare by Cache-Tag after syncs (Zone.Cache Purge).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Daily means archive (R2 SoR + Postgres scratch tip) ---
# See doc/postgres-r2-daily-archive.md.
#
# Local/dev (default below): filesystem store under tmp/ — no Cloudflare account needed.
# After `bin/rails db:seed`, export with `bin/rails archive:export_daily` then open a
# gauge 1y/3y chart. DAILY_ARCHIVE_HOT_RETENTION_DAYS is the Postgres daily scratch tip.
DAILY_ARCHIVE_STORE=local
DAILY_ARCHIVE_LOCAL_PATH=tmp/daily_archive
DAILY_ARCHIVE_HOT_RETENTION_DAYS=7
DAILY_ARCHIVE_READS=1
DAILY_ARCHIVE_DUAL_WRITE=1
DAILY_ARCHIVE_PRUNE=0
#
# Production / real R2: set DAILY_ARCHIVE_STORE=r2 (or unset), fill these.
# Default scratch tip is 7 days when DAILY_ARCHIVE_HOT_RETENTION_DAYS is omitted.
# DAILY_ARCHIVE_STORE=r2
# DAILY_ARCHIVE_PRUNE=1
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_YEARLY_ARCHIVE_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Optional: enables /admin login (session form + /admin/sidekiq). Leave unset to 404.
DASHBOARD_PW=
