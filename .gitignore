# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/yarn-error.log
.env
.env*.local
/config/master.key
/config/credentials/*.key
.byebug_history
.DS_Store
/coverage
